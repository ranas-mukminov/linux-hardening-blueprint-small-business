# Generated by linux-hardener. Manual edits will be overwritten.
Port {{ ssh_port }}
Protocol 2
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

LoginGraceTime {{ ssh_login_grace_time }}
MaxAuthTries {{ ssh_max_auth_tries }}
PermitRootLogin {{ ssh_profile.ssh_permit_root_login | default('no') }}
PasswordAuthentication {{ 'yes' if ssh_profile.ssh_password_auth | default(false) else 'no' }}
ChallengeResponseAuthentication no
UsePAM yes
X11Forwarding no
PrintMotd no
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}
AllowGroups {% for group in ssh_allow_groups %}{{ group }} {% endfor %}
Banner /etc/ssh/sshd_banner

KexAlgorithms {{ ssh_kex | join(',') }}
Ciphers {{ ssh_ciphers | join(',') }}
MACs {{ ssh_macs | join(',') }}
GSSAPIAuthentication no
PermitEmptyPasswords no
AllowTcpForwarding yes
TCPKeepAlive yes
MaxSessions 10
Subsystem sftp /usr/lib/openssh/sftp-server

{% if ssh_profile.idle_timeout | default(0) %}
ClientAliveInterval {{ ssh_profile.idle_timeout }}
ClientAliveCountMax 1
{% endif %}

# Two-minute idle termination for hardened profile
{% if ssh_profile.strict_session_termination | default(false) %}
ClientAliveInterval 120
ClientAliveCountMax 1
{% endif %}
